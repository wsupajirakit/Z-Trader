# zTraderActor configuration. Copy to .env for local development (never commit .env).
# In Coolify, set these in the application's Environment Variables tab instead.

# --- zTraderService (required) ---
# Base URL of zTraderService, without a trailing slash.
API_TRADER_URL=http://localhost:6500
# Machine API key shared with zTraderService (x-api-key). At least 32 characters.
API_KEY=replace-with-a-random-key-of-at-least-32-characters

# --- HTTP ---
PORT=3000
# Number of reverse-proxy hops in front of the app. 0 for local dev, 1 behind Coolify/Traefik.
TRUST_PROXY=0
# silent | error | warn | info | debug
LOG_LEVEL=info

# --- Legacy Sonic/Scalper strategy loop ---
# Comma-separated symbols the loop watches.
SYMBOL=XAUUSD
# Hardcode | Conservative | Swing | Merge | Sonic | Scalper
STRATEGY_MODE=Sonic
MAX_POSITIONS=1
# Fixed lot size; leave empty to derive it from TRADE_AMOUNT_USD.
TRADE_LOT_SIZE=
TRADE_AMOUNT_USD=10
