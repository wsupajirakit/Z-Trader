{
  "name": "ztrader-service",
  "version": "1.0.0",
  "description": "zTrader \u2014 cTrader gold/FX trading service with a multi-user dashboard",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "nest build",
    "build:web": "npm --prefix web run build",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/e2e/**/*.mts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/e2e/**/*.mts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/e2e/**/*.mts\"",
    "user:create": "node dist/cli/create-user.js",
    "pretest": "npm run build:api",
    "test": "npm run test:e2e && npm run test:instruments && npm run test:web",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.mts\"",
    "test:instruments": "node test/gold-ai-assist.test.js && node test/gemini-shape.test.js && node test/instrument-fx.test.js && node test/ai-lead.test.js && node test/security.test.js && node test/multi-instrument.test.js && node test/gold-guards.test.js && npm run test:tv && npm run test:ratelimit && npm run test:records",
    "test:regression": "node test/instrument-regression.test.js",
    "test:security": "node test/security.test.js",
    "baseline": "bash scripts/make-baseline.sh",
    "backtest:export": "node scripts/backtest-export.js",
    "backtest:run": "node scripts/backtest-run.js",
    "test:web": "npm --prefix web test",
    "test:all": "npm test && npm run test:regression",
    "test:tv": "node --test test/tv-protocol.test.js",
    "test:ratelimit": "node --test test/history-limiter.test.js test/deal-cache.test.js",
    "test:records": "node --test test/round-context.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.3.2",
    "adm-zip": "^0.6.1",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "protobufjs": "^8.8.1",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "technicalindicators": "^3.1.0",
    "ws": "^8.22.0",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/adm-zip": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
