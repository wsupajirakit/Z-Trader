# zTraderService environment. Copy to .env and fill in the placeholders. Never commit .env.
# The keys in the first sections are validated at boot (src/config/env.validation.ts): the service refuses
# to start with a list of problems if one is missing or unsafe. GOLD_* / FX_* knobs have code defaults.

# ---------- Runtime / HTTP ----------
# development | production | test (test also makes ConfigModule ignore .env)
NODE_ENV=development
PORT=6500
# Reverse-proxy hops in front of the app (Coolify/Traefik = 1). 0 = trust no X-Forwarded-* header.
TRUST_PROXY=0
# auto = Secure + __Host- cookie when the request is HTTPS (as seen through TRUST_PROXY) · true/false = force
SESSION_COOKIE_SECURE=auto
# Built dashboard bundle (npm run build:web). Missing = API only, with a warning at boot.
WEB_DIST_DIR=./web/dist
# Login attempts per IP per minute, on top of the per-account lockout (5 failures = 15 min)
LOGIN_RATE_LIMIT_PER_MIN=10

# Git commit of the build, recorded with every round and order (optional; set by CI / docker build)
# APP_COMMIT=

# ---------- MongoDB ----------
# users, sessions, audit log, orders
MONGO_URI=mongodb://localhost:27017/ztrader

# ---------- Machine API ----------
# x-api-key for zTraderActor, the /gold-run skill and curl. Never accepted by the dashboard API.
# At least 32 characters: openssl rand -hex 32
API_KEY=replace-with-output-of-openssl-rand-hex-32

# ---------- zTraderActor bridge (optional) ----------
# Base URL of zTraderActor (legacy Sonic/Scalper loop). The dashboard shows and controls it through
# /api/actor/*, calling the Actor's /api/machine/* with the API_KEY above (both sides must share it).
# Unset/empty = the dashboard's Actor panel reports "ACTOR_URL is not configured".
ACTOR_URL=http://localhost:3000

# ---------- First admin (first run only) ----------
# Creates this admin when the users collection is empty, with a forced password change at first login.
# Set both or neither. Remove them once the admin exists. Alternative: npm run user:create
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- cTrader Open API ----------
APP_ID=your_app_id
APP_SECRET=your_app_secret
# Expires after about 30 days; the bot stops trading quietly when it does
ACCESS_TOKEN=your_access_token
# Only read by refresh_token.local.js (token rotation helper), not by the service
REFRESH_TOKEN=your_refresh_token

# Trading account
# โค้ดอ่านตาม CTRADER_ACCOUNT_MODE: DEMO -> DEMO_ACCOUNT_ID · LIVE -> LIVE_ACCOUNT_ID
CTRADER_ACCOUNT_MODE=DEMO
# Second switch for real money: CTRADER_ACCOUNT_MODE=LIVE without CTRADER_ALLOW_LIVE=true refuses to boot
CTRADER_ALLOW_LIVE=false
DEMO_ACCOUNT_ID=your_demo_account_id
LIVE_ACCOUNT_ID=your_live_account_id
# Endpoint override only. Unset = demo.ctraderapi.com for DEMO, live.ctraderapi.com for LIVE.
# CTRADER_HOST=
CTRADER_PORT=5035

# ---------- Telegram (optional) ----------
# Trade / NO-TRADE / reject notifications. Empty = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- TradingView chart data (optional) ----------
# Dashboard chart source "tv:<EXCHANGE>" (/api/chart). All empty = anonymous access, which works but
# is rate-limited harder by TradingView. Precedence: TV_USERNAME + TV_PASSWORD (sign-in, token kept
# in memory and refreshed) -> TV_AUTH_TOKEN (a session token pasted from a signed-in browser; also
# the fallback when sign-in fails) -> anonymous. Never logged.
TV_USERNAME=
TV_PASSWORD=
TV_AUTH_TOKEN=

# ---------- Gold AI bot (XAU_AUTOMATE) ----------
# Master switch for the scheduled XAUUSD AI loop
# ค่าที่ตั้งจาก dashboard ถูกจำลงไฟล์นี้ และถูกโหลดกลับตอนบูต (ทับค่าใน .env)
# มีไว้กันเคส: ตั้งค่าปลอดภัยไว้ -> รีสตาร์ท -> เด้งกลับไปค่า .env ที่หลวมกว่าเงียบ ๆ
# ลบไฟล์นี้ = กลับไปใช้ค่าใน .env ทั้งหมด
GOLD_SETTINGS_FILE=./data/runtime-settings.json
GOLD_AUTOMATE_ENABLED=false
# Comma-separated: scalp,intraday,swing,position
GOLD_MODES=swing
# Comma-separated instruments to trade concurrently: XAUUSD,EURUSD,GBPUSD,USDJPY
# ว่าง/ไม่ตั้ง = เทรดตราสาร active ตัวเดียวตาม TRADE_INSTRUMENT (พฤติกรรมเดิม)
# แต่ละตราสารวิเคราะห์/มีไม้ค้างแยกจากกันโดยสมบูรณ์ — เปลี่ยนได้จาก dashboard ตอน loop หยุดด้วย
GOLD_INSTRUMENTS=
# Data source: local = build in-process (XAUUSD from cTrader + companions from Yahoo,
# same modes/formula as z-service gold.py) · remote = pull ZIP from z-service
GOLD_DATA_SOURCE=local
# XAUUSD symbol id on the cTrader account (IC Markets = 41)
GOLD_XAU_SYMBOL_ID=41
# Only used when GOLD_DATA_SOURCE=remote:
GOLD_EXPORT_BASE_URL=https://z-service.example.com
GOLD_PULL_KEY=your_pull_key
# Analysis engine: ta = rule-based TA in-code (default, no API needed)
#                  ai = Claude analysis (needs ANTHROPIC_API_KEY)
GOLD_ENGINE=ta
ANTHROPIC_API_KEY=
GOLD_AI_MODEL=claude-opus-5
# JSON history of every round under ./archive/<mode>/ (bars kept per series; 0 = meta only)
GOLD_ARCHIVE_DIR=./archive
# เก็บกี่แท่งต่อ series ในไฟล์ archive — ใช้ replay ย้อนหลัง (test/instrument-regression.test.js)
# ต้อง >= 250 ถึงจะ replay เส้นทางที่พึ่ง EMA200 ได้ (ทิศ swing / macro filter intraday)
# 120 แท่งเดิม = ตอน replay จะโดนด่าน ema200Ready ปัดทุกครั้ง เทสต์ครอบคลุมได้น้อยลง
GOLD_ARCHIVE_BARS=260
# Skip a round when the newest bar of a required series is older than N × its timeframe (default 3)
GOLD_MAX_BAR_AGE_MULT=3
# Risk settings — sizing: risk = ทุกไม้เสี่ยง $ เท่ากัน (แนะนำ) · fixed = lot คงที่
GOLD_SIZING=risk
GOLD_RISK_USD_PER_TRADE=1500
# เพดาน lot ของ "ทอง" เท่านั้น (ตราสารอื่นใช้ GOLD_MAX_LOT_<KEY> หรือค่าใน instruments.ts)
# 0.1 มาจากการเทียบความผันผวน: ทอง $8,679/วัน/lot vs EURUSD $464/วัน/lot (ต่างกัน ~19 เท่า)
# FX เพดาน 2 lot ขยับได้ ~$927/วัน -> ทอง 0.1 lot ขยับได้ ~$868/วัน = เสี่ยงพอ ๆ กัน
GOLD_MAX_LOT=0.1
# Per-instrument lot cap: GOLD_MAX_LOT_<KEY> > GOLD_MAX_LOT (gold only) > profile maxLot in instruments.ts
# Empty = fall through. Also editable from the dashboard.
GOLD_MAX_LOT_XAUUSD=
GOLD_MAX_LOT_EURUSD=
GOLD_MAX_LOT_GBPUSD=
GOLD_MAX_LOT_USDJPY=
# โหมดที่แต่ละตราสารเทรดได้ — ว่าง/ไม่ตั้ง = ใช้ค่าใน instruments.ts (tradableModes)
# ทองถูกจำกัดไว้ที่ scalp,intraday เพราะไม้ต่ำสุด 0.01 lot ของทองเสี่ยง ~$1/จุด
# โหมด SL กว้าง (swing ~35 จุด) ไม้ต่ำสุดก็เสี่ยง ~$35 ลดกว่านี้ไม่ได้ = คุมงบต่อไม้ไม่ได้จริง
# ตั้งเองได้ถ้ายอมรับความเสี่ยง เช่น GOLD_MODES_XAUUSD=scalp,intraday,swing
GOLD_MODES_XAUUSD=
GOLD_MODES_EURUSD=
GOLD_MODES_GBPUSD=
GOLD_MODES_USDJPY=
GOLD_RISK_TOLERANCE=1.2
GOLD_SCALP_MAX_PER_DAY=40
GOLD_BASE_LOT=0.1
GOLD_MAX_OPEN_POSITIONS=20
# เพดานไม้ค้างรวมทุกตราสารเมื่อเปิดหลายตัวพร้อมกัน (GOLD_INSTRUMENTS) · 0 = ไม่จำกัด (ใช้แค่เพดานต่อตราสารข้างบน)
GOLD_MAX_OPEN_POSITIONS_TOTAL=0
# เพดานที่ TA ทำได้จริงคือ 8 — ตั้ง 9/10 = ไม่มีไม้ไหนผ่าน บอทเงียบสนิท
GOLD_MIN_CONFIDENCE=7
# 0 = disabled; otherwise stop trading for the day after losing this many USD
GOLD_DAILY_MAX_LOSS_USD=4000
# skip re-entry for N bars of the mode's TF after a losing close (0 = off)
GOLD_LOSS_COOLDOWN_BARS=3
# UTC hour(s) to run position mode (after 1d close), comma-separated
GOLD_POSITION_RUN_UTC_HOURS=22

# ---------- ตราสาร (ทอง / คู่เงิน) ----------
# ตราสารที่บอทเทรดตอนบูต: XAUUSD | EURUSD | GBPUSD | USDJPY — เปลี่ยนได้จาก dashboard ตอน loop หยุด
# ทุกอย่าง (ข้อมูล/playbook/TA/AI prompt/ข่าว/ชั่วโมงตลาด/lot sizing) ปรับตามตราสารอัตโนมัติ
TRADE_INSTRUMENT=XAUUSD
# symbolId บน cTrader ของคู่เงิน — ปกติไม่ต้องตั้ง ระบบค้นจากชื่อ symbol ให้เอง (ตั้งเฉพาะเมื่อ broker ใช้ชื่อต่าง)
FX_EURUSD_SYMBOL_ID=
FX_GBPUSD_SYMBOL_ID=
FX_USDJPY_SYMBOL_ID=

# ---------- AI assist (ตัวช่วยหาจุดเข้า — เสริมบน TA ไม่ใช่แทน) ----------
# เปิด/ปิดได้จากหน้า start loop ทันที ค่านี้เป็นแค่ค่าเริ่มต้นตอนบูต
# บทบาทของ AI: off = ใช้ TA ล้วน · assist = AI ตรวจไม้ที่ TA หามา (ลดความเสี่ยงได้อย่างเดียว)
#              lead = assist + เมื่อ TA ไม่เจอ setup ให้ AI หาไม้เอง (ขนาดไม่เกินครึ่ง ผ่านด่านเข้มกว่า)
# เปลี่ยนได้จาก dashboard ทันที ค่านี้เป็นแค่ค่าเริ่มต้นตอนบูต
# เพดานการเรียก AI ต่อวัน (UTC) · 0 = ไม่จำกัด
# ชนเพดาน = สลับไปใช้ TA ล้วนอัตโนมัติ บอทไม่หยุดเทรด · กลับมาเองเมื่อข้ามวันหรือกดรีเซ็ต
# ถาม AI ตอนไหน — วัดจาก archive จริง 2,412 รอบ:
#   near_miss  (แนะนำ) TA เจอ setup + NO_TRADE ที่ "เฉียด"        ~29 ครั้ง/วัน
#   setup_only         เฉพาะตอน TA เจอ setup                      ~5  ครั้ง/วัน
#   always             ทุกรอบที่วิเคราะห์จบ (รวมรอบที่ไม่มีอะไร)   ~68 ครั้ง/วัน
# นิยาม "เฉียด" แก้ได้ที่ NEAR_MISS_RULES ใน src/gold/analysis/gold-ta.service.ts (จุดเดียว)
GOLD_AI_GATE=near_miss
# โควตานี้เป็นก้อนเดียว "ใช้ร่วมกันทุกตราสาร" ไม่ได้แยกรายตัว
# เปิดหลายตราสารพร้อมกันจะหมดเร็วขึ้นตามจำนวนตัว แล้วสลับเป็น TA ล้วนเองอัตโนมัติ
# (บอทไม่หยุดเทรด · กลับมาใช้ AI เมื่อข้ามวัน UTC หรือกดรีเซ็ต)
# ค่านี้ผูกกับค่าใช้จ่าย API — ปรับเมื่อเจ้าของบัญชีสั่งเท่านั้น อย่าขยับเอง
GOLD_AI_MAX_CALLS_PER_DAY=10
GOLD_AI_MODE=off
# ส่งสถานะพอร์ต (ไม้ค้าง + P&L วันนี้) ไปให้ AI ด้วยไหม — ช่วยให้ AI ระวังไม้แก้ตัว
# ไม่มี key/token ถูกส่งออกไปไม่ว่ากรณีใด (มีเทสต์ test/security.test.js ยืนยัน)
GOLD_AI_SHARE_PORTFOLIO=true
# (ของเดิม — ใช้ได้อยู่: true = assist · GOLD_AI_MODE ถ้าตั้งไว้จะทับค่านี้)
GOLD_AI_ASSIST=false
GEMINI_API_KEY=
# รุ่น Gemini สำหรับ assist (แยกจาก GOLD_AI_MODEL ซึ่ง engine Claude ใช้ — กันตั้งชนกัน)
GEMINI_MODEL=gemini-3.5-flash
# รุ่น Claude สำหรับ GOLD_ENGINE=ai (ถ้าไม่ตั้งใช้ GOLD_AI_MODEL เมื่อขึ้นต้นด้วย claude- ไม่งั้น claude-opus-5)
GOLD_CLAUDE_MODEL=
# ระดับการคิด: minimal | low | medium | high
GOLD_AI_THINKING=high
GOLD_AI_TEMPERATURE=0.2
GOLD_AI_TOP_K=40
GOLD_AI_TOP_P=0.95
# thinking กินโควตาเดียวกับคำตอบ — high ต้องเผื่อมากกว่านี้
GOLD_AI_MAX_TOKENS=16384
# Unset = 180000 in code
GOLD_AI_TIMEOUT_MS=60000

# ---------- Legacy klines strategy engine (src/klines) ----------
# Event-driven Sonic/Scalper engine for symbols subscribed through /api/v1/klines (zTraderActor).
# Independent of the gold bot above; do not run it on XAUUSD at the same time as the gold loop.
# SONIC | SCALPER | HIGH_WIN_RATE (default SONIC)
STRATEGY_MODE=SONIC
# Optional XAUUSD-only override of STRATEGY_MODE
XAUUSD_MODE=
# Global cap on open positions on the account, all symbols, checked before every legacy order (default 100)
ALL_MAX_POSITIONS=100
# Fixed lot for legacy engine orders (default 0.02)
TRADE_LOT_SIZE=0.02
