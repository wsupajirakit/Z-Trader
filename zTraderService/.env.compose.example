# Variables for docker-compose.yml. Copy this file to .env.compose and fill it in:
#
#   cp .env.compose.example .env.compose
#   docker compose --env-file .env.compose up -d --build
#
# .env.compose holds real secrets: never commit it. This example contains placeholders only.
# Generate every secret with:  openssl rand -hex 32
# (hex keeps passwords URL-safe, and they go inside MONGO_URI)
# On Coolify, put these values in the resource's Environment Variables tab instead of a file.

# ---------- required (compose refuses to start without them) ----------
API_KEY=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# ---------- MongoDB (defaults are fine) ----------
# The app connects as MONGO_APP_USER, which only has readWrite on MONGO_APP_DB. Root is for admin tasks only.
# These are applied when the mongo volume is first created. Changing them later has no effect
# (see docs/deploy.md, "Rotate the database password").
#MONGO_ROOT_USERNAME=root
#MONGO_APP_DB=ztrader
#MONGO_APP_USER=ztrader

# ---------- HTTP ----------
# Host port, and the host interface it binds to (127.0.0.1 = this machine only, 0.0.0.0 = LAN)
#HTTP_PORT=6500
#HTTP_BIND=127.0.0.1
# Reverse-proxy hops in front of the app: 0 locally, 1 behind Coolify/Traefik
TRUST_PROXY=0
# auto = Secure cookie when the request arrived over https (needs TRUST_PROXY behind a proxy)
SESSION_COOKIE_SECURE=auto

# ---------- first admin (first run only, when the users collection is empty) ----------
# username: 3-32 chars of a-z 0-9 . _ -   password: at least 12 chars
# Remove both lines after the first successful login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- cTrader ----------
# DEMO unless BOTH CTRADER_ACCOUNT_MODE=LIVE and CTRADER_ALLOW_LIVE=true (real money)
CTRADER_ACCOUNT_MODE=DEMO
CTRADER_ALLOW_LIVE=false
# empty = demo.ctraderapi.com / live.ctraderapi.com, chosen by CTRADER_ACCOUNT_MODE
CTRADER_HOST=
CTRADER_PORT=5035
APP_ID=
APP_SECRET=
ACCESS_TOKEN=
DEMO_ACCOUNT_ID=
LIVE_ACCOUNT_ID=

# ---------- optional integrations (empty = off) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- bot tuning (optional) ----------
# Uncomment only what you want to change. A line left empty overrides the code's default, so
# keep unused ones commented out. Most risk settings can also be changed on the dashboard, and
# they persist in the `data` volume. See .env.example for what each one does.
#TRADE_INSTRUMENT=XAUUSD
#GOLD_AUTOMATE_ENABLED=false
#GOLD_MODES=swing
#GOLD_INSTRUMENTS=
#GOLD_ENGINE=ta
#GOLD_DATA_SOURCE=local
#GOLD_SIZING=risk
#GOLD_RISK_USD_PER_TRADE=
#GOLD_MAX_LOT=
#GOLD_DAILY_MAX_LOSS_USD=
#GOLD_MAX_OPEN_POSITIONS=
#GOLD_MIN_CONFIDENCE=
#GOLD_AI_MODE=off
#LOGIN_RATE_LIMIT_PER_MIN=10

# ---------- zTraderActor (only with --profile actor) ----------
# Build context of the zTraderActor repo, relative to this directory
#ACTOR_CONTEXT=../zTraderActor
#ACTOR_PORT=3000
#STRATEGY_MODE=Sonic
#SYMBOL=XAUUSD

# ---------- image metadata (optional) ----------
#IMAGE_TAG=local
#IMAGE_VERSION=dev
#GIT_REVISION=
